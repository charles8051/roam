{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Development": {
      "commandName": "Project",
      "environmentVariables": {
        "SAMPLEAPP_MODE": "healthy",
        "SAMPLEAPP_READY_FILE": "./artifacts/ready.txt",
        "SAMPLEAPP_MANIFEST_PATH": "./artifacts/manifest.json",
        "SAMPLEAPP_MARKER_DIR": "./artifacts/markers"
      }
    },
    "Production": {
      "commandName": "Project",
      "environmentVariables": {
        "SAMPLEAPP_MODE": "healthy",
        "SAMPLEAPP_MANIFEST_PATH": "./artifacts/manifest.json",
        "SAMPLEAPP_MARKER_DIR": "./artifacts/markers"
      }
    },
    "DelayedStart": {
      "commandName": "Project",
      "environmentVariables": {
        "SAMPLEAPP_MODE": "delayed-start",
        "SAMPLEAPP_DELAY_SECONDS": "3",
        "SAMPLEAPP_READY_FILE": "./artifacts/ready.txt",
        "SAMPLEAPP_MANIFEST_PATH": "./artifacts/manifest.json"
      }
    },
    "CrashOnStart": {
      "commandName": "Project",
      "environmentVariables": {
        "SAMPLEAPP_MODE": "crash-on-start"
      }
    }
  }
}